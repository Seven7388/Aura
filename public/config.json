{
  "version": "2.0.0",
  "server_address": "auto",
  "dns_router": {
    "listen_udp": "0.0.0.0:53",
    "listen_tcp": "0.0.0.0:53",
    "mode": "multi",
    "default_tunnel": "default"
  },
  "socks5": {
    "enabled": true,
    "listen": "127.0.0.1:1080",
    "auth": false
  },
  "stuntls": {
    "enabled": true,
    "listen": "0.0.0.0:443",
    "backend": "127.0.0.1:2222",
    "min_tls": "1.2",
    "max_tls": "1.3"
  },
  "udpgw": {
    "enabled": true,
    "listen": "127.0.0.1:7300",
    "max_clients": 1000
  },
  "multiplexer": {
    "enabled": true,
    "listen": "127.0.0.1:2222",
    "ssh_target": "127.0.0.1:22",
    "socks_target": "127.0.0.1:1080"
  },
  "tunnels": [
    {
      "tag": "dnstt-primary",
      "transport": "dnstt",
      "backend": "both",
      "domain": "t.example.com",
      "mtu": 1232,
      "port": 5300
    },
    {
      "tag": "stuntls-443",
      "transport": "stuntls",
      "port": 443,
      "min_tls": "1.2"
    }
  ]
}
