{
  "version": "2.0.0",
  "server_address": "auto",
  "dns_router": {
    "listen_udp": "0.0.0.0:53",
    "listen_tcp": "0.0.0.0:53",
    "mode": "multi",
    "default_tunnel": "dnstt"
  },
  "socks5": {
    "enabled": true,
    "listen": "0.0.0.0:1080",
    "auth": false
  },
  "stuntls": {
    "enabled": true,
    "listen": "0.0.0.0:443",
    "backend": "127.0.0.1:2222",
    "min_tls": "1.2",
    "max_tls": "1.3"
  },
  "udpgw": {
    "enabled": true,
    "listen": "0.0.0.0:7300",
    "max_clients": 1000
  },
  "multiplexer": {
    "enabled": true,
    "listen": "127.0.0.1:2222",
    "ssh_target": "127.0.0.1:22",
    "socks_target": "127.0.0.1:1080"
  },
  "tunnels": [
    {
      "tag": "dnstt",
      "transport": "dnstt",
      "domain": "t.<domain>",
      "port": 5300,
      "mtu": 1232
    },
    {
      "tag": "noizdns",
      "transport": "noizdns",
      "domain": "n.<domain>",
      "port": 5301,
      "mtu": 1232,
      "encoding": "base36"
    },
    {
      "tag": "slipstream",
      "transport": "slipstream",
      "domain": "s.<domain>",
      "port": 5302
    },
    {
      "tag": "vaydns",
      "transport": "vaydns",
      "domain": "v.<domain>",
      "port": 5303,
      "mtu": 1232,
      "record_type": "txt"
    },
    {
      "tag": "soar-direct",
      "transport": "soar",
      "backend": "direct",
      "domain": "r.<domain>",
      "port": 5304
    },
    {
      "tag": "soar-ssh",
      "transport": "soar",
      "backend": "ssh",
      "domain": "rs.<domain>",
      "port": 5305
    },
    {
      "tag": "stuntls",
      "transport": "stuntls",
      "port": 443,
      "min_tls": "1.2",
      "max_tls": "1.3"
    }
  ]
}
